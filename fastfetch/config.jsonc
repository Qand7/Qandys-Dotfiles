{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/qandy/.config/fastfetch/logos/kitty.txt",
    "padding": {
	"top": 2,
	"left": 4
    },
    "color": {
      "1": "white"
    }
  },
  "display": {
    "separator": " ✦ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌───────────────── \u001b[33mお\u001b[34mや\u001b[35mす\u001b[36mみ\u001b[0m ───────────────┐"
    },
    {
      "type": "os",
      "key": "  \uf31f OS",
      "format": "{2}",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "  ├  Kernel",
      "format": "{2}",
      "keyColor": "\u001b[93m"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "  ├  CPU",
      "keyColor": "#E61C5D"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "  ├ 󰢮 GPU",
      "keyColor": "#5900FF"
    },
    {
      "type": "memory",
      "key": "  ├   Memory",
      "keyColor": "\u001b[32m"
    },
    {
      "type": "display",
      "key": "  ├ 󰍹 Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "\u001b[33m"
    },
    {
      "type": "uptime",
      "key": "  ├ 󱫐 Uptime ",
      "keyColor": "\u001b[35m"
    },
    {
      "type": "battery",
      "key": "  ├ \uf240 Battery",
      "format": "{4} [{5}]",
      "keyColor": ""
    },
    {
      "type": "terminal",
      "key": "  ├  Terminal",
      "keyColor": "\u001b[92m"
    },
    {
      "type": "shell",
      "key": "  ├  Shell",
      "keyColor": ""
    },
    {
      "type": "wm",
      "key": "  ├ 󱗃 WM",
      "format": "{2}",
      "keyColor": "#332DE0"
    },
    {
      "type": "command",
      "key": "  └ 󱦟 OS Age ",
      "keyColor": "#FFBD39",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
